# 私密資料：絕不進 git（排程提示詞備份、金鑰等放這裡）
private/
.env
.env.*
*credentials*.json
*service-account*.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
htmlcov/

